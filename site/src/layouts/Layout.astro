---
import '../styles/global.css';
import { href, usingFixtures } from '../lib/data';
const { title, description = 'Sourced context, site verdicts and safety checks for AI agents.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} · Agent Homepage</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/><link rel="alternate" type="application/rss+xml" title="Preflight changes" href={href('changes.xml')}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet"/></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href={href()}>Agent Homepage<span aria-hidden="true">↗</span></a><nav aria-label="Main"><a href={href('sites')}>Sites</a><a href={href('methodology')}>Methodology</a><a href={href('api')}>API</a><a href={href('mcp')}>MCP</a></nav></header><main id="main">{usingFixtures && <aside class="notice">Demo data · These are fictional fixtures, not live scans or signed findings.</aside>}<slot/></main><footer><p class="footer-brand">Check before you act.</p><p>Preflight is advisory · not legal or security advice.</p><nav aria-label="Footer"><a href={href('bot')}>Our crawler</a><a href={href('privacy')}>Privacy</a><a href={href('terms')}>Terms</a><a href="https://github.com/legacy-ev/preflight/issues">Contact & disputes</a><a href={href('changes.xml')}>RSS</a></nav></footer></body></html>
