---
import Layout from '../layouts/Layout.astro';
import { records, href, date } from '../lib/data';
---
<Layout title="Before an agent acts"><h1>Check before you act.</h1><p class="intro">GO, CAUTION or STOP. Website access findings, routes and evidence for agents — with the date behind every decision.</p><a class="action" href={href('methodology')}>How verdicts work</a><section aria-labelledby="domains"><h2 id="domains">Domain leaderboard</h2><p>Read intent only. Alphabetical order; this is an access index, not a merchant recommendation.</p><label for="filter">Find a domain</label><input id="filter" type="search" placeholder="Filter by domain or verdict"/><p id="count" aria-live="polite">{records.length} domains</p><div class="table-wrap"><table><thead><tr><th scope="col">Domain</th><th scope="col">Verdict</th><th scope="col">Reasons</th><th scope="col">Checked at</th></tr></thead><tbody>{records.map(r=><tr data-domain={`${r.domain} ${r.verdict}`.toLowerCase()}><td><a href={href(`site/${r.domain}`)}>{r.domain}</a></td><td class={`verdict ${r.verdict}`}>{r.verdict}</td><td>{r.reasons.length}</td><td><time datetime={r.generated_at}>{date(r.generated_at)}</time></td></tr>)}</tbody></table></div></section><section><h2>A verdict has limits.</h2><p>GO means no rule fired in the published snapshot. It does not grant permission, guarantee safety or authorise a purchase. Check freshness and the website’s own rules before acting.</p><a href={href('api')}>Read the same data as JSON →</a></section></Layout>
<script>const filter=document.querySelector<HTMLInputElement>('#filter');filter?.addEventListener('input',()=>{let visible=0;document.querySelectorAll<HTMLTableRowElement>('tr[data-domain]').forEach(row=>{row.hidden=!row.dataset.domain?.includes(filter.value.toLowerCase().trim());if(!row.hidden)visible++;});document.querySelector('#count')!.textContent=`${visible} domains`;});</script>
